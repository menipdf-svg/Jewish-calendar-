            android:textColor="@color/widget_preview_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView style="@style/WidgetPreviewHeaderButton" android:text="‹" />
        <TextView style="@style/WidgetPreviewHeaderButton" android:layout_width="28dp" android:text="26" android:textStyle="bold" />
