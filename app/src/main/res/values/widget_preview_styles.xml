<?xml version="1.0" encoding="utf-8"?>
<!-- Shared looks for the static widget-picker previews. -->
<resources>
    <style name="WidgetPreviewHeaderButton">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/preview_widget_cell_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_preview_on_surface</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="WidgetPreviewAddButton" parent="WidgetPreviewHeaderButton">
        <item name="android:layout_width">30dp</item>
        <item name="android:background">@drawable/preview_widget_today_bg</item>
        <item name="android:textColor">@color/widget_preview_on_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="WidgetPreviewWeekDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/preview_widget_cell_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_preview_on_surface</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
